{
  "schema_version": "1.0",
  "enabled": true,
  "data_dir": "~/.codex/orchestrator/telemetry",
  "ledger_file": "events.jsonl",
  "retention_days": 90,
  "max_ledger_bytes": 10485760,
  "max_events_per_task": 64,
  "permissions": {
    "directory": "0700",
    "file": "0600"
  },
  "capture": {
    "prompt_text": false,
    "conversation_text": false,
    "source_code": false,
    "file_contents": false,
    "full_file_paths": false,
    "raw_tool_output": false,
    "secrets": false
  },
  "export": {
    "aggregate_only": true,
    "include_task_ids": false,
    "include_project_ids": false
  }
}