{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "jaskeeratsingh1",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
