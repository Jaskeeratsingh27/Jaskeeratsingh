# Do not commit real values.
JIRA_CLOUD_ID=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Bootstrap only. After first OAuth refresh, the rotated token is persisted encrypted.
JIRA_OAUTH_REFRESH_TOKEN=

# Fernet key. Generate outside Git and store as a hosting-platform secret.
CONTROL_PLANE_SECRET_KEY=

CONTROL_PLANE_DB_PATH=/data/control-plane.db
CONTROL_PLANE_ROTATING_SECRETS_PATH=/data/rotating-secrets.enc
WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=5
WORKER_BASE_BACKOFF_SECONDS=30
WORKER_MAX_BACKOFF_SECONDS=900

# GitHub App credentials are supported by provider_auth.py/provider_clients.py and
# reserved for GitHub-side worker operations as they are added to the outbox.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
