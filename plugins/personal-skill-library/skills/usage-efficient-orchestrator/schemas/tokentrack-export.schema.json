{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenTrack Orchestrator Aggregate Export",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "window_days",
    "summary",
    "by_role",
    "by_profile",
    "by_complexity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "summary": {
      "type": "object",
      "required": [
        "tasks_started",
        "tasks_finished",
        "success_count",
        "blocked_count",
        "failed_count",
        "budget_stops",
        "measured_tasks",
        "unmeasured_tasks",
        "total_measured_burn_points",
        "average_measured_burn_points",
        "reset_or_invalid_pairs"
      ],
      "additionalProperties": false,
      "properties": {
        "tasks_started": {
          "type": "integer",
          "minimum": 0
        },
        "tasks_finished": {
          "type": "integer",
          "minimum": 0
        },
        "success_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "budget_stops": {
          "type": "integer",
          "minimum": 0
        },
        "measured_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "unmeasured_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "total_measured_burn_points": {
          "type": "number",
          "minimum": 0
        },
        "average_measured_burn_points": {
          "type": "number",
          "minimum": 0
        },
        "reset_or_invalid_pairs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "by_role": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "by_profile": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "by_complexity": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}